{
  "name": "opencharacter-monorepo",
  "private": true,
  "description": "Open Character Format (OCF): spec, reference engine, and content packs.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web-editor/tsconfig.json",
    "test": "vitest run",
    "validate": "tsx --conditions=@opencharacter/source scripts/validate/cli.ts",
    "types": "tsx --conditions=@opencharacter/source scripts/types/cli.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate",
    "changeset": "changeset",
    "build": "pnpm build:ts && pnpm build:packs",
    "build:ts": "pnpm --filter @opencharacter/spec --filter @opencharacter/engine --filter @opencharacter/text run build",
    "build:packs": "tsx --conditions=@opencharacter/source scripts/build/cli.ts",
    "release:check": "tsx --conditions=@opencharacter/source scripts/release/check-cli.ts",
    "release:setup": "tsx --conditions=@opencharacter/source scripts/release/npm-setup-cli.ts",
    "version-packages": "changeset version && tsx --conditions=@opencharacter/source scripts/release/sync-cli.ts",
    "release": "pnpm check && pnpm build && pnpm release:check",
    "editor": "pnpm --filter @opencharacter/web-editor dev",
    "website": "pnpm --filter @opencharacter/website dev",
    "build:website": "pnpm --filter @opencharacter/website build"
  },
  "devDependencies": {
    "@changesets/assemble-release-plan": "7.0.0",
    "@changesets/cli": "3.0.3",
    "@changesets/config": "4.0.1",
    "@changesets/parse": "1.0.0",
    "@changesets/types": "7.0.0",
    "@manypkg/get-packages": "3.1.0",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "semver": "^7.8.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.20.0"
}
