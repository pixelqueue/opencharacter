{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "proseWrap": "preserve",
  "ignorePatterns": [
    "LICENSE",
    "packs/LICENSE",
    "CODE_OF_CONDUCT.md",
    "pnpm-lock.yaml",
    ".changeset/*.md",
    ".claude/worktrees"
  ]
}
