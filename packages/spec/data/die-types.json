{
  "set": "die-types",
  "specVersion": "0.1.0",
  "description": "Kinds of dice the notation can roll.",
  "items": [
    {
      "id": "numeric",
      "notation": "dN",
      "example": "1d8",
      "faces": "1..N",
      "description": "A die with faces 1 to N."
    },
    {
      "id": "percentile",
      "notation": "d%",
      "example": "1d%",
      "faces": "1..100",
      "description": "Same as d100."
    },
    {
      "id": "fate",
      "notation": "dF",
      "example": "4dF",
      "faces": "-1, 0, +1",
      "description": "Fate/Fudge dice."
    },
    {
      "id": "zeroBased",
      "notation": "dNz",
      "example": "1d100z",
      "faces": "0..N-1",
      "description": "A die with faces 0 to N - 1 (Mothership's d100 reads 00–99)."
    }
  ]
}
