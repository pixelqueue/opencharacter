{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencharacterformat.org/schemas/0.3/engine/upgrade.schema.json",
  "title": "upgrade",
  "$defs": {
    "input": {
      "type": "object",
      "required": ["from", "to", "character"],
      "properties": {
        "from": {
          "$ref": "ruleset.schema.json"
        },
        "to": {
          "$ref": "ruleset.schema.json"
        },
        "character": {
          "$ref": "../character.schema.json"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "oneOf": [
        {
          "type": "object",
          "required": ["ok", "character", "pending", "report"],
          "properties": {
            "ok": {
              "const": true
            },
            "character": {
              "$ref": "../character.schema.json"
            },
            "pending": {
              "type": "array",
              "items": {
                "$ref": "compute-sheet.schema.json#/$defs/pendingChoice"
              }
            },
            "report": {
              "description": "What changed: the character computed under both versions.",
              "type": "object",
              "properties": {
                "values": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["field"],
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "before": {
                        "$ref": "../common.schema.json#/$defs/literal"
                      },
                      "after": {
                        "$ref": "../common.schema.json#/$defs/literal"
                      },
                      "shownBefore": {
                        "description": "Whether the field was shown on the old sheet (computeSheet's `shown`); present with `before`.",
                        "type": "boolean"
                      },
                      "shownAfter": {
                        "description": "Whether the field is shown on the new sheet; present with `after`.",
                        "type": "boolean"
                      }
                    }
                  }
                },
                "steps": {
                  "description": "Upgrade steps that changed this character, with the script each came from.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["pack", "from", "to", "step"],
                    "properties": {
                      "pack": {
                        "type": "string"
                      },
                      "from": {
                        "type": "string"
                      },
                      "to": {
                        "type": "string"
                      },
                      "step": {
                        "$ref": "../upgrade.schema.json#/$defs/step"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "spec": {
                  "description": "Present when the character's `specVersion` moved to the engine's: the version it had, and each spec upgrade step that changed the character.",
                  "type": "object",
                  "required": ["from", "steps"],
                  "properties": {
                    "from": {
                      "$ref": "../common.schema.json#/$defs/semver"
                    },
                    "steps": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["version", "step"],
                        "properties": {
                          "version": {
                            "description": "The spec upgrade's `id`: the version that changed the shape.",
                            "$ref": "../common.schema.json#/$defs/semver"
                          },
                          "step": {
                            "$ref": "../spec-upgrade.schema.json#/$defs/step"
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "errors": {
                  "description": "The upgraded character's computeSheet errors (references no script handled).",
                  "type": "array",
                  "items": {
                    "$ref": "error.schema.json"
                  }
                },
                "homebrew": {
                  "description": "Each place in the character's homebrew a step rewrote, in order.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["path", "step"],
                    "properties": {
                      "path": {
                        "description": "A JSON Pointer into the upgraded character.",
                        "type": "string"
                      },
                      "step": {
                        "$ref": "../upgrade.schema.json#/$defs/step"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "load-ruleset.schema.json#/$defs/failure"
        }
      ]
    }
  }
}
