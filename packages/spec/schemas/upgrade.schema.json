{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencharacterformat.org/schemas/0.2/upgrade.schema.json",
  "title": "Upgrade script",
  "description": "Data, not code: moves saved characters from one pack version to the next when the saved state's shape changes. Scripts chain one version at a time. Steps are a fixed set kept in sync with `data/upgrade-steps.json`; computed defaults are formulas.",
  "type": "object",
  "required": ["pack", "from", "to", "steps"],
  "properties": {
    "pack": {
      "$ref": "common.schema.json#/$defs/packId"
    },
    "from": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "to": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "step": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "enum": [
            "renameContent",
            "removeContent",
            "renameField",
            "removeField",
            "setDefault",
            "mapValues",
            "renameState",
            "removeState",
            "moveState",
            "stateToField",
            "renameChoice",
            "removeChoice",
            "renameOption",
            "requireChoice",
            "renameContentType",
            "renameItemField",
            "removeItemField",
            "mapItemValues",
            "renameTag",
            "renameAction",
            "adoptStandard"
          ]
        },
        "from": {
          "description": "The old name. renameContent, renameField, renameContentType, renameItemField, renameTag, renameAction: the ID. renameState, moveState, stateToField: the state key. renameChoice: the choice ID on `owner`, or a prefixed choice key as saved (`<qualified id>/<choice>`, a granted or template content's choice), whose picks in `owner`'s trees become its choice `to`. renameOption: the picked option.",
          "type": "string"
        },
        "to": {
          "description": "The new name, as for `from`. moveState: the target's state key (default `from`). stateToField: the item field (default `from`). renameOption: the replacing option; absent, the pick is removed.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "field": {
          "$ref": "common.schema.json#/$defs/fieldRef"
        },
        "type": {
          "description": "renameState, removeState, moveState, stateToField: limits the step to content of this content type (with `item`, both must match). renameItemField, removeItemField, mapItemValues: the homebrew items' content type.",
          "$ref": "common.schema.json#/$defs/name"
        },
        "value": {
          "$ref": "formula.schema.json"
        },
        "map": {
          "type": "object",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/literal"
          }
        },
        "owner": {
          "description": "Choice steps: whose choice it is (absent: the rules). moveState: the owner of `choice`, whose pick of `option` in the copy's own choice tree, at any depth, receives the value (absent: a rules-level choice). A path names a choice nested in an inline option (see `choiceOwner`).",
          "$ref": "#/$defs/choiceOwner"
        },
        "choice": {
          "description": "removeChoice, renameOption, requireChoice: the choice on `owner`, as saved (a slot is its own key). moveState: the choice whose pick receives the value; a slotted one is searched slot by slot.",
          "$ref": "common.schema.json#/$defs/slug"
        },
        "item": {
          "description": "adoptStandard: the item whose standard copy an entry becomes. renameState, removeState, moveState, stateToField: limits the step to content `item` and homebrew items extending it (with `type`, both must match).",
          "$ref": "common.schema.json#/$defs/ref"
        },
        "key": {
          "description": "removeState: the state key to drop.",
          "$ref": "common.schema.json#/$defs/name"
        },
        "grant": {
          "description": "moveState: the granted content whose saved state on the copy (its `grants`) receives the value.",
          "$ref": "common.schema.json#/$defs/ref"
        },
        "option": {
          "description": "moveState: the picked option, in choice `choice` of `owner` (or the rules), whose pick receives the value.",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "number"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "renameContent",
                  "renameField",
                  "renameState",
                  "renameChoice",
                  "renameContentType",
                  "renameItemField",
                  "renameTag",
                  "renameAction"
                ]
              }
            },
            "type": "object"
          },
          "then": {
            "required": ["from", "to"],
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "removeContent"
              }
            },
            "type": "object"
          },
          "then": {
            "required": ["id"],
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "removeField"
              }
            },
            "type": "object"
          },
          "then": {
            "required": ["field"],
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "setDefault"
              }
            },
            "type": "object"
          },
          "then": {
            "required": ["field", "value"],
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "mapValues"
              }
            },
            "type": "object"
          },
          "then": {
            "required": ["field", "map"],
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "requireChoice"
              }
            },
            "type": "object"
          },
          "then": {
            "required": ["choice"],
            "type": "object"
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "op": {
                "const": "renameOption"
              }
            }
          },
          "then": {
            "type": "object",
            "required": ["choice", "from"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "op": {
                "enum": ["renameItemField", "removeItemField", "mapItemValues"]
              }
            }
          },
          "then": {
            "type": "object",
            "required": ["type"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "op": {
                "const": "removeItemField"
              }
            }
          },
          "then": {
            "type": "object",
            "required": ["field"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "op": {
                "const": "mapItemValues"
              }
            }
          },
          "then": {
            "type": "object",
            "required": ["field", "map"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "op": {
                "const": "adoptStandard"
              }
            }
          },
          "then": {
            "type": "object",
            "required": ["item"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "op": {
                "const": "removeState"
              }
            }
          },
          "then": {
            "type": "object",
            "required": ["key"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "op": {
                "const": "moveState"
              }
            }
          },
          "then": {
            "type": "object",
            "required": ["from"],
            "oneOf": [
              {
                "type": "object",
                "required": ["grant"],
                "not": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": ["choice"]
                    },
                    {
                      "type": "object",
                      "required": ["option"]
                    },
                    {
                      "type": "object",
                      "required": ["owner"]
                    }
                  ]
                }
              },
              {
                "type": "object",
                "required": ["choice", "option"],
                "not": {
                  "type": "object",
                  "required": ["grant"]
                }
              }
            ]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "op": {
                "const": "stateToField"
              }
            }
          },
          "then": {
            "type": "object",
            "required": ["from"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "op": {
                "const": "removeChoice"
              }
            }
          },
          "then": {
            "type": "object",
            "required": ["choice"]
          }
        }
      ],
      "additionalProperties": false
    },
    "choiceOwner": {
      "description": "Whose choice a step names: content (a local or qualified ID); for a choice nested in an inline option, that content then each choice and inline option down to it, joined by `/` (`classes.operative/specialization/ghost`). A path with an even number of parts starts at a rules-level choice (`motto/brave`). Absent: the rules.",
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/ref"
        },
        {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(([a-z0-9]+([-.][a-z0-9]+)*:[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)*|[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)*)/[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*|[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*)(/[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*)*$"
        }
      ]
    }
  }
}
