{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencharacterformat.org/schemas/0.1/formula.schema.json",
  "title": "Formula",
  "description": "A formula in the OCF formula language (CEL-like syntax plus dice notation), defined in docs/formulas.md. In pack sources a formula is text, or a plain number or boolean (a formula with no inputs). Releases carry `compiled` formulas: canonical text plus the parsed tree.",
  "anyOf": [
    {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    {
      "type": "number"
    },
    {
      "type": "boolean"
    }
  ],
  "$defs": {
    "condition": {
      "description": "A formula that must evaluate to true or false (`when`, `showWhen`, prerequisites, query `where`).",
      "$ref": "#"
    },
    "dice": {
      "description": "A formula containing dice notation, e.g. `1d8`, `2d20kh1 + abilities.str.mod`, `(actions.skirmish)d6kh1`.",
      "$ref": "#"
    },
    "tree": {
      "description": "A parsed formula: plain JSON. See docs/formulas.md, \"The tree\". Trees produced by the parser round-trip exactly through the printer.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "int",
            "decimal",
            "string",
            "ref",
            "bool",
            "null",
            "list",
            "name",
            "member",
            "index",
            "call",
            "unary",
            "binary",
            "conditional",
            "dice"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "int"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/nodes/int"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "decimal"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/nodes/decimal"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/nodes/string"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ref"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/nodes/ref"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bool"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/nodes/bool"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "null"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/nodes/null"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "list"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/nodes/list"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "name"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/nodes/name"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "member"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/nodes/member"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "index"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/nodes/index"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "call"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/nodes/call"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "unary"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/nodes/unary"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "binary"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/nodes/binary"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "conditional"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/nodes/conditional"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dice"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/nodes/dice"
          }
        }
      ]
    },
    "compiled": {
      "description": "A formula as it appears in a release: canonical text plus its parsed tree.",
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string"
        },
        "tree": {
          "$ref": "#/$defs/tree"
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "int": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": {
            "const": "int"
          },
          "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false
      },
      "decimal": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": {
            "const": "decimal"
          },
          "value": {
            "description": "The literal's value, rounded to six places when parsed (docs/formulas.md, \"Six places\").",
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "string": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": {
            "const": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ref": {
        "description": "An ID literal: `@classes.fighter`. Its value is a string, the content, field, content type, action or link slot ID resolved in the formula's pack (qualified).",
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": {
            "const": "ref"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "bool": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": {
            "const": "bool"
          },
          "value": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "null": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "const": "null"
          }
        },
        "additionalProperties": false
      },
      "list": {
        "type": "object",
        "required": ["type", "items"],
        "properties": {
          "type": {
            "const": "list"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/tree"
            }
          }
        },
        "additionalProperties": false
      },
      "name": {
        "type": "object",
        "required": ["type", "path"],
        "properties": {
          "type": {
            "const": "name"
          },
          "path": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      },
      "member": {
        "type": "object",
        "required": ["type", "object", "name"],
        "properties": {
          "type": {
            "const": "member"
          },
          "object": {
            "allOf": [
              {
                "$ref": "#/$defs/tree"
              },
              {
                "not": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "name"
                    }
                  },
                  "required": ["type"]
                }
              }
            ]
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "additionalProperties": false
      },
      "index": {
        "type": "object",
        "required": ["type", "object", "index"],
        "properties": {
          "type": {
            "const": "index"
          },
          "object": {
            "$ref": "#/$defs/tree"
          },
          "index": {
            "$ref": "#/$defs/tree"
          }
        },
        "additionalProperties": false
      },
      "call": {
        "type": "object",
        "required": ["type", "fn", "args"],
        "properties": {
          "type": {
            "const": "call"
          },
          "fn": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "args": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/tree"
            }
          }
        },
        "additionalProperties": false
      },
      "unary": {
        "type": "object",
        "required": ["type", "op", "operand"],
        "properties": {
          "type": {
            "const": "unary"
          },
          "op": {
            "enum": ["-", "!"]
          },
          "operand": {
            "$ref": "#/$defs/tree"
          }
        },
        "additionalProperties": false
      },
      "binary": {
        "type": "object",
        "required": ["type", "op", "left", "right"],
        "properties": {
          "type": {
            "const": "binary"
          },
          "op": {
            "enum": ["||", "&&", "<", "<=", ">", ">=", "==", "!=", "in", "+", "-", "*", "/", "%"]
          },
          "left": {
            "$ref": "#/$defs/tree"
          },
          "right": {
            "$ref": "#/$defs/tree"
          }
        },
        "additionalProperties": false
      },
      "conditional": {
        "type": "object",
        "required": ["type", "test", "then", "else"],
        "properties": {
          "type": {
            "const": "conditional"
          },
          "test": {
            "$ref": "#/$defs/tree"
          },
          "then": {
            "$ref": "#/$defs/tree"
          },
          "else": {
            "$ref": "#/$defs/tree"
          }
        },
        "additionalProperties": false
      },
      "dice": {
        "type": "object",
        "required": ["type", "count", "sides", "modifiers"],
        "properties": {
          "type": {
            "const": "dice"
          },
          "count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "$ref": "#/$defs/tree"
              }
            ]
          },
          "sides": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "const": "F"
              }
            ]
          },
          "modifiers": {
            "type": "array",
            "items": {
              "$ref": "roll-item.schema.json#/$defs/diceModifier"
            }
          },
          "zero": {
            "description": "A zero-based die (`d100z`): faces 0 to sides - 1. Present only when true.",
            "const": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}
